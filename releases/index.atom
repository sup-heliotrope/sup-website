---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>https://supmua.dev/releases/</id>
  <title>sup releases</title>
  <link rel="self" type="application/atom+xml" href="https://supmua.dev/releases/index.atom" />
  <link rel="alternate" type="text/html" href="https://supmua.dev/releases/" />
  <updated>{{ site.data.releases.first.date | date: "%Y-%m-%dT%H:%M:%S%:z" }}</updated>
  <author>
    <name>Sup developers</name>
    <email>list@supmua.dev</email>
  </author>
{%- for release in site.data.releases %}
  <entry>
    <id>https://supmua.dev/releases/sup-{{ release.version }}.gem</id>
    <title>sup {{ release.version }}</title>
    <link rel="enclosure" type="application/octet-stream" href="https://supmua.dev/releases/sup-{{ release.version }}.gem" />
    <updated>{{ release.date | date: "%Y-%m-%dT%H:%M:%S%:z" }}</updated>
    <content type="html">
      &lt;p&gt;Sup {{ release.version }} was released on {{ release.date | date: "%d %B %Y" }}.&lt;/p&gt;
      &lt;p&gt;Download: &lt;a href="https://supmua.dev/releases/sup-{{ release.version }}.gem"&gt;sup-{{ release.version }}.gem&lt;/a&gt;&lt;br /&gt;
      SHA256: {{ release.sha256 }}&lt;/p&gt;
      &lt;p&gt;For release notes, refer to &lt;a href="https://supmua.dev/git/sup/file/History.txt.html"&gt;History.txt&lt;/a&gt; in the Sup source code.&lt;/p&gt;
    </content>
  </entry>
{%- endfor %}
</feed>
